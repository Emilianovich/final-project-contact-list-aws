# Local only: copy to .env and replace secrets before starting.
WEB_PORT=8080
API_PORT=3000
BACKEND_UPSTREAM=http://api:3000
FRONTEND_ORIGIN=http://localhost:8080
# Only for a short-lived public-IP test without an ALB. Keep false for stable deployments.
CORS_ALLOW_ANY_ORIGIN=false
DB_NAME=contactos
DB_USER=contactos_app
DB_PASSWORD=replace-with-local-db-password
DB_SSL=false
DB_SSL_CA_PATH=
JWT_ACCESS_SECRET=replace-with-unique-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-different-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
